			if btn.Text == "Disco [F3X]" then local LocalPlayer = game:GetService("Players").LocalPlayer local Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait() local Backpack = LocalPlayer:FindFirstChild("Backpack") local function findHDAdminF3X(parent) if not parent then return nil end for _, item in ipairs(parent:GetChildren()) do if item:IsA("Tool") and (item.Name:find("Building") or item.Name:find("F3X") or item:FindFirstChild("SyncAPI", true)) then return item end end return nil end local f3xTool = findHDAdminF3X(Character) or findHDAdminF3X(Backpack) local SyncAPI = f3xTool:FindFirstChild("SyncAPI", true) local function invokeSyncAPI(action, ...) if SyncAPI:IsA("RemoteFunction") then return SyncAPI:InvokeServer(action, ...) elseif SyncAPI:IsA("BindableFunction") then return SyncAPI:Invoke(action, ...) end end local spawnCFrame = Character.HumanoidRootPart.CFrame * CFrame.new(0, 1.3, 0) local targetPart = invokeSyncAPI("CreatePart", "Normal", spawnCFrame, workspace) invokeSyncAPI("SyncAnchor", {{Part = targetPart, Anchored = true}}) invokeSyncAPI("SyncResize", {{Part = targetPart, CFrame = targetPart.CFrame, Size = Vector3.new(1000, 2, 1000)}}) pcall(function() invokeSyncAPI("SyncMaterial", {{Part = targetPart, Material = targetPart.Material, Transparency = 0.75}}) end) pcall(function() invokeSyncAPI("SyncCollision", {{Part = targetPart, CanCollide = false}}) end) local discoColors = { Color3.fromRGB(255, 0, 0), Color3.fromRGB(0, 255, 0), Color3.fromRGB(255, 255, 0), Color3.fromRGB(0, 0, 255), Color3.fromRGB(0, 0, 139), Color3.fromRGB(128, 0, 128), Color3.fromRGB(255, 192, 203), Color3.fromRGB(0, 0, 0), Color3.fromRGB(255, 255, 255) } task.spawn(function() while true do for _, color in ipairs(discoColors) do pcall(function() invokeSyncAPI("SyncColor", { {Part = targetPart, Color = color, UnionColoring = true} }) end) task.wait(0.3) end end end) end
