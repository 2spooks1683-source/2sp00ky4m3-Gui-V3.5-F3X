			if btn.Text == "Disco [F3X]" then local LocalPlayer = game:GetService("Players").LocalPlayer local Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait() local Backpack = LocalPlayer:FindFirstChild("Backpack") local function findHDAdminF3X(parent) if not parent then return nil end for _, item in ipairs(parent:GetChildren()) do if item:IsA("Tool") and (item.Name:find("Building") or item.Name:find("F3X") or item:FindFirstChild("SyncAPI", true)) then return item end end return nil end local f3xTool = findHDAdminF3X(Character) or findHDAdminF3X(Backpack) local SyncAPI = f3xTool:FindFirstChild("SyncAPI", true) local function invokeSyncAPI(action, ...) if SyncAPI:IsA("RemoteFunction") then return SyncAPI:InvokeServer(action, ...) elseif SyncAPI:IsA("BindableFunction") then return SyncAPI:Invoke(action, ...) end end local spawnCFrame = Character.HumanoidRootPart.CFrame * CFrame.new(0, 1.3, 0) local targetPart = invokeSyncAPI("CreatePart", "Normal", spawnCFrame, workspace) invokeSyncAPI("SyncAnchor", {{Part = targetPart, Anchored = true}}) invokeSyncAPI("SyncResize", {{Part = targetPart, CFrame = targetPart.CFrame, Size = Vector3.new(1000, 2, 1000)}}) pcall(function() invokeSyncAPI("SyncMaterial", {{Part = targetPart, Material = targetPart.Material, Transparency = 0.75}}) end) pcall(function() invokeSyncAPI("SyncCollision", {{Part = targetPart, CanCollide = false}}) end) local discoColors = { Color3.fromRGB(255, 0, 0), Color3.fromRGB(0, 255, 0), Color3.fromRGB(255, 255, 0), Color3.fromRGB(0, 0, 255), Color3.fromRGB(0, 0, 139), Color3.fromRGB(128, 0, 128), Color3.fromRGB(255, 192, 203), Color3.fromRGB(0, 0, 0), Color3.fromRGB(255, 255, 255) } task.spawn(function() while true do for _, color in ipairs(discoColors) do pcall(function() invokeSyncAPI("SyncColor", { {Part = targetPart, Color = color, UnionColoring = true} }) end) task.wait(0.3) end end end) end
			if btn.Text == "Smooth Disco" then local player = game.Players.LocalPlayer local char = player.Character or player.CharacterAdded:Wait() local tool for _, v in ipairs(player:GetDescendants()) do if v.Name == "SyncAPI" then tool = v.Parent break end end if not tool then for _, v in ipairs(game.ReplicatedStorage:GetDescendants()) do if v.Name == "SyncAPI" then tool = v.Parent break end end end if not tool then return end local remote = tool.SyncAPI.ServerEndpoint local function _(args) remote:InvokeServer(unpack(args)) end local function CreatePart(cf, parent) _({"CreatePart", "Normal", cf, parent}) end local function SetName(part, name) _({"SetName", {part}, name}) end local function AddMesh(part) _({"CreateMeshes", {{Part = part}}}) end local function SetMesh(part, id) _({"SyncMesh", {{Part = part, MeshId = "rbxassetid://" .. id}}}) end local function MeshResize(part, size) _({"SyncMesh", {{Part = part, Scale = size}}}) end local function SetVertexColor(part, vec) _({"SyncMesh", {{Part = part, VertexColor = vec}}}) end local function SetColor(part, color) _({"SyncColor", {{Part = part, Color = color}}}) end local function SetLocked(part, bool) _({"SetLocked", {part}, bool}) end local function SetMaterialAndReflectance(part, mat, reflectanceVal) _({"SyncMaterial", {{Part = part, Material = mat, Reflectance = reflectanceVal}}}) end local function SetCollision(part, bool) _({"SyncCollision", {{Part = part, CanCollide = bool}}}) end local function CreatePointLight(part) _({"CreateLights", {{Part = part, LightType = "PointLight"}}}) end local function SyncPointLight(part, brightness, range) _({"SyncLighting", {{Part = part, LightType = "PointLight", Brightness = brightness, Range = range}}}) end local function Sky() local pos = Vector3.new(0, 10, 0) CreatePart(CFrame.new(pos), workspace) for _, v in ipairs(workspace:GetDescendants()) do if v:IsA("BasePart") and not v:IsDescendantOf(char) and math.floor(v.Position.X) == 0 and math.floor(v.Position.Y) == 10 and math.floor(v.Position.Z) == 0 then SetName(v, "Sky") AddMesh(v) SetMesh(v, "111891702759441") MeshResize(v, Vector3.new(98000, 98000, 98000)) SetColor(v, Color3.fromRGB(255, 255, 255)) SetVertexColor(v, Vector3.new(1, 1, 1)) SetMaterialAndReflectance(v, Enum.Material.Neon, 1.1) SetCollision(v, false) CreatePointLight(v) SyncPointLight(v, 5, 8) SetLocked(v, true) end end end Sky() task.wait(0.1) local ReplicatedStorage = game:GetService("ReplicatedStorage") local RequestCommand = ReplicatedStorage:WaitForChild("HDAdminHDClient").Signals.RequestCommandSilent local colors = { "red", "orange", "green", "blue", "darkblue", "purple", "red", "darkblue", "green", "orange" } while true do for _, color in ipairs(colors) do RequestCommand:InvokeServer(":fogcolor " .. color) task.wait(2) end end end
			if btn.Text == "c00lkidd disco" then local LocalPlayer = game:GetService("Players").LocalPlayer local Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait() local Backpack = LocalPlayer:FindFirstChild("Backpack") local function findHDAdminF3X(parent) if not parent then return nil end for _, item in ipairs(parent:GetChildren()) do if item:IsA("Tool") and (item.Name:find("Building") or item.Name:find("F3X") or item:FindFirstChild("SyncAPI", true)) then return item end end return nil end local f3xTool = findHDAdminF3X(Character) or findHDAdminF3X(Backpack) local SyncAPI = f3xTool:FindFirstChild("SyncAPI", true) local function invokeSyncAPI(action, ...) if SyncAPI:IsA("RemoteFunction") then return SyncAPI:InvokeServer(action, ...) elseif SyncAPI:IsA("BindableFunction") then return SyncAPI:Invoke(action, ...) end end local spawnCFrame = Character.HumanoidRootPart.CFrame * CFrame.new(0, -2, 0) local targetPart = invokeSyncAPI("CreatePart", "Normal", spawnCFrame, workspace) invokeSyncAPI("SyncAnchor", {{Part = targetPart, Anchored = true}}) invokeSyncAPI("SyncResize", {{Part = targetPart, CFrame = targetPart.CFrame, Size = Vector3.new(1000, 2, 1000)}}) pcall(function() invokeSyncAPI("SyncMaterial", {{Part = targetPart, Material = Enum.Material.ForceField, Transparency = 0}}) end) pcall(function() invokeSyncAPI("SyncCollision", {{Part = targetPart, CanCollide = false}}) end) local discoColors = { Color3.fromRGB(255, 0, 0), Color3.fromRGB(0, 255, 0), Color3.fromRGB(255, 255, 0), Color3.fromRGB(0, 0, 255), Color3.fromRGB(0, 0, 139), Color3.fromRGB(128, 0, 128), Color3.fromRGB(255, 192, 203), Color3.fromRGB(0, 0, 0), Color3.fromRGB(255, 255, 255) } task.spawn(function() while true do for _, color in ipairs(discoColors) do pcall(function() invokeSyncAPI("SyncColor", { {Part = targetPart, Color = color, UnionColoring = true} }) end) task.wait(0.5) end end end) end
			if btn.Text == "Floody" then local Workspace = game:GetService("Workspace") local Players = game:GetService("Players") local ReplicatedStorage = game:GetService("ReplicatedStorage") local LocalPlayer = Players.LocalPlayer local Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait() local hdClient = ReplicatedStorage:FindFirstChild("HDAdminHDClient") if hdClient and hdClient:FindFirstChild("Signals") then local requestCommand = hdClient.Signals:FindFirstChild("RequestCommandSilent") if requestCommand then requestCommand:InvokeServer(":gear me 236438668") end end local function applyHDAdminTerrainHook() local terrain = Workspace.Terrain Workspace.ChildAdded:Connect(function(child) if child.Name:find("HDAdmin") or child:IsA("Model") or child:IsA("BasePart") then local hrp = Character:FindFirstChild("HumanoidRootPart") if hrp then local targetCFrame = hrp.CFrame * CFrame.new(0, 250, 0) terrain:FillBlock(targetCFrame, Vector3.new(400, 500, 400), Enum.Material.Water) end end end) end applyHDAdminTerrainHook() end
