cMaterial", {{["Part"] = part, ["Transparency"] = 0}}}) sendF3XCommand({"SyncTransparency", {{["Part"] = part, ["Transparency"] = 0}}}) sendF3XCommand({"SyncCollision", {{["Part"] = part, ["CanCollide"] = false}}}) sendF3XCommand({"CreateTextures", {{["Part"] = part, ["Face"] = Enum.NormalId.Back, ["TextureType"] = "Decal"}}}) sendF3XCommand({"SyncTexture", {{["Part"] = part, ["Face"] = Enum.NormalId.Back, ["TextureType"] = "Decal", ["Texture"] = IMAGE_ID}}}) sendF3XCommand({"CreateLights", {{["Part"] = part, ["LightType"] = "PointLight", ["Face"] = Enum.NormalId.Back}}}) sendF3XCommand({"SyncLighting", {{["Part"] = part, ["LightType"] = "PointLight", ["Range"] = 11, ["Brightness"] = 0.7}}}) break end end end task.wait(0.2) local ReplicatedStorage = game:GetService("ReplicatedStorage") local RequestCommand = ReplicatedStorage:WaitForChild("HDAdminHDClient").Signals.RequestCommandSilent RequestCommand:InvokeServer(":music 138902022840864 :volume 10") task.wait(3) RequestCommand:InvokeServer(":unmusic") RequestCommand:InvokeServer(":respawn all") end
			if btn.Text == "Color Spam" then local player = game.Players.LocalPlayer local char = player.Character or player.CharacterAdded:Wait() local backpack = player:WaitForChild("Backpack") local function getF3XTool() for _, item in ipairs(backpack:GetChildren()) do if item:FindFirstChild("SyncAPI") then return item end end for _, item in ipairs(char:GetChildren()) do if item:FindFirstChild("SyncAPI") then return item end end return nil end local f3x = getF3XTool() if not f3x then warn("F3X aracı bulunamadı!") return end local syncAPI = f3x.SyncAPI local serverEndpoint = syncAPI.ServerEndpoint local function setPartColor(part, color) local args = { [1] = "SyncColor", [2] = { [1] = { ["Part"] = part, ["Color"] = color, ["UnionColoring"] = false } } } serverEndpoint:InvokeServer(unpack(args)) end local function colorAllParts() for _, object in ipairs(workspace:GetDescendants()) do if object:IsA("BasePart") or object:IsA("UnionOperation") then task.spawn(function() local randomColor = Color3.fromRGB( math.random(0, 255), math.random(0, 255), math.random(0, 255) ) setPartColor(object, randomColor) end) end end end colorAllParts() end
			if btn.Text == "Disco [HD ADMIN]" then local ReplicatedStorage = game:GetService("ReplicatedStorage") local RequestCommand = ReplicatedStorage:WaitForChild("HDAdminHDClient").Signals.RequestCommandSilent RequestCommand:InvokeServer(":disco") end
