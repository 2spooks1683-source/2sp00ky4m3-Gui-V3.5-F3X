			if btn.Text == "Color Spam" then local player = game.Players.LocalPlayer local char = player.Character or player.CharacterAdded:Wait() local backpack = player:WaitForChild("Backpack") local function getF3XTool() for _, item in ipairs(backpack:GetChildren()) do if item:FindFirstChild("SyncAPI") then return item end end for _, item in ipairs(char:GetChildren()) do if item:FindFirstChild("SyncAPI") then return item end end return nil end local f3x = getF3XTool() if not f3x then warn("F3X aracı bulunamadı!") return end local syncAPI = f3x.SyncAPI local serverEndpoint = syncAPI.ServerEndpoint local function setPartColor(part, color) local args = { [1] = "SyncColor", [2] = { [1] = { ["Part"] = part, ["Color"] = color, ["UnionColoring"] = false } } } serverEndpoint:InvokeServer(unpack(args)) end local function colorAllParts() for _, object in ipairs(workspace:GetDescendants()) do if object:IsA("BasePart") or object:IsA("UnionOperation") then task.spawn(function() local randomColor = Color3.fromRGB( math.random(0, 255), math.random(0, 255), math.random(0, 255) ) setPartColor(object, randomColor) end) end end end colorAllParts() end
