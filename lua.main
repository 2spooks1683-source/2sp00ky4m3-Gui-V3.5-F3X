ame.new(v.CFrame.x,v.CFrame.y + 3,v.CFrame.z)) end end end end) end local function C_1f() local script = G2L["1f"]; local imageLabel = script.Parent local textbox = imageLabel.Parent:WaitForChild("nugget") local function updateImage() local id = textbox.Text if id == "" then id = "97579765099209" end if not string.find(id, "rbxassetid://") then id = "rbxassetid://" .. id end imageLabel.Image = id end end task.spawn(C_1f); end
