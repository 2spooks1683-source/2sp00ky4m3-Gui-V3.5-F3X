or(v.Position.Z) == 0 then SetName(v, "Sky") AddMesh(v) SetMesh(v, "111891702759441") MeshResize(v, Vector3.new(98000, 98000, 98000)) SetColor(v, Color3.fromRGB(255, 255, 255)) SetVertexColor(v, Vector3.new(1, 1, 1)) SetMaterialAndReflectance(v, Enum.Material.Neon, 1.1) SetCollision(v, false) CreatePointLight(v) SyncPointLight(v, 5, 8) SetLocked(v, true) end end end Sky() task.wait(0.1) local ReplicatedStorage = game:GetService("ReplicatedStorage") local RequestCommand = ReplicatedStorage:WaitForChild("HDAdminHDClient").Signals.RequestCommandSilent local colors = { "red", "orange", "green", "blue", "darkblue", "purple", "red", "darkblue", "green", "orange" } while true do for _, color in ipairs(colors) do RequestCommand:InvokeServer(":fogcolor " .. color) task.wait(2) end end end
