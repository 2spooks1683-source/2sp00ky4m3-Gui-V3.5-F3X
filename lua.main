			if btn.Text == "Restore Skybox" then local ReplicatedStorage = game:GetService("ReplicatedStorage") local RequestCommand = ReplicatedStorage:WaitForChild("HDAdminHDClient").Signals.RequestCommandSilent RequestCommand:InvokeServer(":time 12") task.wait(0.1) local Players = game:GetService("Players") local LocalPlayer = Players.LocalPlayer local Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait() local TARGET_MESH_ID = "111891702759441" local function getF3XEndpoint() local tool = Character:FindFirstChildOfClass("Tool") if tool and tool:FindFirstChild("SyncAPI") then return tool.SyncAPI:FindFirstChild("ServerEndpoint") end for _, item in ipairs(LocalPlayer.Backpack:GetChildren()) do if item:FindFirstChild("SyncAPI") then return item.SyncAPI:FindFirstChild("ServerEndpoint") end end return nil end local serverEndpoint = getF3XEndpoint() if serverEndpoint then local function sendF3XCommand(args) pcall(function() serverEndpoint:InvokeServer(unpack(args)) end) end local function hasTargetMesh(part) for _, child in ipairs(part:GetChildren()) do if child:IsA("SpecialMesh") or child:IsA("FileMesh") or child:IsA("Mesh") then local meshId = tostring(child.MeshId) if meshId:find(TARGET_MESH_ID) then return true end end end return false end local partsToClean = {} for _, obj in ipairs(workspace:GetDescendants()) do if obj:IsA("BasePart") and hasTargetMesh(obj) then table.insert(partsToClean, obj) end end if #partsToClean > 0 then sendF3XCommand({"SetLocked", partsToClean, false}) task.wait(0.1) sendF3XCommand({"UndoParenting", partsToClean}) local resizeData = {} local moveData = {} local transData = {} for _, part in ipairs(partsToClean) do local voidCFrame = CFrame.new(0, -999999, 0) table.insert(moveData, {["Part"] = part, ["CFrame"] = voidCFrame}) table.insert(resizeData, {["Part"] = part, ["CFrame"] = voidCFrame, ["Size"] = Vector3.new(0.05, 0.05, 0.05)}) table.insert(transData, {["Part"] = part, ["Transparency"] = 1}) end sendF3XCommand({"SyncTransparency", transData}) sendF3XCommand({"SyncResize", resizeData}) sendF3XCommand({"SyncMove", moveData}) else end else end end
