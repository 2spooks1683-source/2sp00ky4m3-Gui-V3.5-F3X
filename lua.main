l", {{["Part"] = part, ["Transparency"] = 0}}}) sendF3XCommand({"SyncTransparency", {{["Part"] = part, ["Transparency"] = 0}}}) sendF3XCommand({"SyncCollision", {{["Part"] = part, ["CanCollide"] = false}}}) sendF3XCommand({"CreateTextures", {{["Part"] = part, ["Face"] = Enum.NormalId.Back, ["TextureType"] = "Decal"}}}) sendF3XCommand({"SyncTexture", {{["Part"] = part, ["Face"] = Enum.NormalId.Back, ["TextureType"] = "Decal", ["Texture"] = IMAGE_ID}}}) sendF3XCommand({"CreateLights", {{["Part"] = part, ["LightType"] = "PointLight", ["Face"] = Enum.NormalId.Back}}}) sendF3XCommand({"SyncLighting", {{["Part"] = part, ["LightType"] = "PointLight", ["Range"] = 11, ["Brightness"] = 0.7}}}) break end end end task.wait(0.2) local ReplicatedStorage = game:GetService("ReplicatedStorage") local RequestCommand = ReplicatedStorage:WaitForChild("HDAdminHDClient").Signals.RequestCommandSilent RequestCommand:InvokeServer(":music 35935204 :pitch 1.1 :volume 10") task.wait(6) RequestCommand:InvokeServer(":unmusic") RequestCommand:InvokeServer(":respawn all") end
